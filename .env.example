# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 말 것.
DOMAIN=donbug.ruraeru.xyz
# 웹 컨테이너가 열 호스트 포트 (앞단 리버스 프록시가 여기로 넘김)
WEB_PORT=3004
DB_PASSWORD=
DB_ROOT_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# AI 노무 도우미 (https://console.anthropic.com). 비우면 AI 기능만 꺼진다.
