# Flutter 웹 정적 파일 + /api 는 백엔드로. 같은 origin 이라 CORS 불필요.
# HTTPS 는 앞단 리버스 프록시가 맡는다. 여기서는 평문 HTTP(컨테이너 80, 호스트 WEB_PORT)만 받는다.
:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# 해시 없는 진입 파일(index.html, main.dart.js, flutter_service_worker.js, version.json 등)은
	# 매번 재검증(ETag → 304)해서 배포 직후 옛 앱이 남지 않게 한다. 정적 리소스 폴더만 캐시 허용.
	@entry not path /api/* /assets/* /canvaskit/* /icons/*
	header @entry Cache-Control "no-cache"
	@static path /assets/* /canvaskit/* /icons/*
	header @static Cache-Control "public, max-age=3600"

	handle /api/* {
		reverse_proxy be:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
